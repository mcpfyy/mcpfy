# Copy this file to .env and fill in the values you need.
# .env is loaded automatically by the dev/start scripts — nothing else to configure.

# Optional: enables MCPFY telemetry (usage/latency/error visibility in the MCPFY
# dashboard) with zero code changes. Get a key from Telemetry > Create Telemetry
# in the dashboard. Leave unset and nothing about this server changes.
# MCPFY_API_KEY=mk_live_xxx

# Optional: public MCP origin for widget iframe fetch (merged into CSP).
# MCPFY_URL=https://your-host.example/mcp
