{
  "name": "{{PROJECT_NAME}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server with a React widget, built with mcpfy.",
  "scripts": {
    "dev": "mcpfy dev{{MCPFY_DEV_ARGS}}",
    "dev:stdio": "mcpfy dev -- --stdio",
    "dev:http": "mcpfy dev -- --http --port {{DEFAULT_PORT}}",
    "build": "mcpfy build && tsc",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "mcpfy-sdk": "{{MCPFY_SDK}}",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
