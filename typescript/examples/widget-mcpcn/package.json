{
  "name": "@mcpfy-examples/widget-mcpcn",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "mcpfy dev",
    "dev:http": "mcpfy dev -- --http",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widget.json",
    "build": "mcpfy build && tsc && tsc -p tsconfig.widget.json",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http",
    "start:stdio": "node dist/server.js --stdio"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mcpfy-sdk": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
